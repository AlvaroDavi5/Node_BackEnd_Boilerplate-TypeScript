{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "node_backend_boilerplate",
	"version": "8.1.2",
	"description": "Node.js Boilerplate for Back-End using TypeScript",
	"license": "MIT",
	"private": false,
	"author": "Álvaro Davi Santos Alves <alvaro-davi1@hotmail.com>",
	"contributors": [
		"Álvaro Davi Santos Alves <alvaro-davi1@hotmail.com>"
	],
	"repository": "https://github.com/AlvaroDavi5/Node_BackEnd_Boilerplate-TypeScript.git",
	"main": "./src/main.ts",
	"engineStrict": true,
	"engines": {
		"node": ">=24.0.x <=24.x.x",
		"npm": ">=12.0.x <=12.x.x",
		"yarn": "0"
	},
	"os": [
		"linux",
		"ubuntu",
		"win32"
	],
	"keywords": [
		"boilerplate",
		"node",
		"typescript",
		"javascript",
		"nestjs"
	],
	"scripts": {
		"typecheck": "tsc --project tsconfig.json --noEmit",
		"build": "nest build",
		"build:webpack": "npm run build && webpack --config webpack.config.ts",
		"start": "nest start",
		"start:prod": "node build/src/main.js",
		"start:webpack": "node build/webpack.js",
		"start:dev": "cross-env NODE_ENV=dev nodemon --config nodemon.json",
		"start:debug": "nest start --debug --watch",
		"security-check": "ts-node --project tsconfig.json ./scripts/security-check.ts",
		"mock-dependencies": "ts-node --project tsconfig.json ./scripts/mock-dependencies.ts",
		"receive-messages": "ts-node --project tsconfig.json scripts/receive-messages.ts",
		"send-message": "ts-node --project tsconfig.json ./scripts/send-message.ts",
		"db:seed": "ts-node --project tsconfig.json ./scripts/seed.ts",
		"db:create": "ts-node --project tsconfig.build.json ./node_modules/typeorm-extension/bin/cli.cjs db:create -d ./src/modules/core/infra/database/db.config.ts",
		"db:drop": "ts-node --project tsconfig.build.json ./node_modules/typeorm-extension/bin/cli.cjs db:drop -d ./src/modules/core/infra/database/db.config.ts",
		"db:schema-sync": "typeorm schema:sync -d build/src/modules/core/infra/database/db.config.js",
		"db:schema-drop": "typeorm schema:drop -d build/src/modules/core/infra/database/db.config.js",
		"db:schema-log": "typeorm schema:log -d build/src/modules/core/infra/database/db.config.js",
		"db:cache-clear": "typeorm cache:clear -d build/src/modules/core/infra/database/db.config.js",
		"db:query-exec": "typeorm query -d build/src/modules/core/infra/database/db.config.js",
		"db:migration-show": "typeorm migration:show -d build/src/modules/core/infra/database/db.config.js",
		"db:migration-run": "typeorm migration:run -d build/src/modules/core/infra/database/db.config.js",
		"db:migration-revert": "typeorm migration:revert -d build/src/modules/core/infra/database/db.config.js",
		"db:migration-generate": "typeorm migration:generate -d build/src/modules/core/infra/database/db.config.js",
		"db:migration-create": "typeorm migration:create",
		"db:entity-create": "typeorm entity:create",
		"db:subscriber-create": "typeorm subscriber:create",
		"test": "npm run test:unit && npm run test:integration && npm run test:e2e",
		"test:coverage": "npm run test:unit:coverage && npm run test:integration:coverage && npm run test:e2e:coverage",
		"test:unit": "cross-env NODE_OPTIONS=--experimental-vm-modules jest -c tests/jest.config.ts --verbose --runInBand",
		"test:unit:#it": "cross-env NODE_OPTIONS=--experimental-vm-modules jest -t=#it -c tests/jest.config.ts --verbose --runInBand",
		"test:unit:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest -c tests/jest.config.ts --watch --verbose --detectOpenHandles",
		"test:unit:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest -c tests/jest.config.ts --coverage --runInBand",
		"test:integration": "cross-env NODE_OPTIONS=--experimental-vm-modules jest -c tests/jest.integration.config.ts",
		"test:integration:#it": "cross-env NODE_OPTIONS=--experimental-vm-modules jest -t=#it -c tests/jest.integration.config.ts",
		"test:integration:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest -c tests/jest.integration.config.ts --watch --detectOpenHandles",
		"test:integration:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest -c tests/jest.integration.config.ts --runInBand --coverage",
		"test:e2e": "cross-env NODE_OPTIONS=--experimental-vm-modules jest -c tests/jest.e2e.config.ts --runInBand",
		"test:e2e:#it": "cross-env NODE_OPTIONS=--experimental-vm-modules jest -t=#it -c tests/jest.e2e.config.ts --runInBand",
		"test:e2e:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest -c tests/jest.e2e.config.ts --watch --detectOpenHandles",
		"test:e2e:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest -c tests/jest.e2e.config.ts --runInBand --coverage --runInBand",
		"sonar:prepare": "npm run coverage:merge:prepare && npm run coverage:merge:unify && npm run coverage:merge:report",
		"sonar:scan": "sonar-scanner-npm",
		"coverage:merge:prepare": "cp coverage/unit/coverage-final.json coverage/unit.json && cp coverage/integration/coverage-final.json coverage/integration.json && cp coverage/e2e/coverage-final.json coverage/e2e.json",
		"coverage:merge:unify": "nyc merge coverage/ coverage/coverage-final.json",
		"coverage:merge:report": "nyc report -t coverage/ --report-dir coverage/ --reporter=html --reporter=cobertura",
		"backstage:build-docs": "npx @techdocs/cli build",
		"backstage:view-docs": "npx @techdocs/cli serve",
		"lint": "oxlint --config .oxlintrc.json src tests scripts",
		"lint:fix": "oxlint --config .oxlintrc.json src tests scripts --quiet --fix",
		"lint:strict": "oxlint --config .oxlintrc.json src tests scripts --deny-warnings",
		"format": "oxfmt --check src tests scripts",
		"format:fix": "oxfmt src tests scripts",
		"typeorm:cli": "ts-node --project tsconfig.build.json ./node_modules/typeorm/cli -d ./src/modules/core/infra/database/db.config.ts",
		"commit": "git-cz",
		"versioning": "semantic-release",
		"postinstall": "lefthook install"
	},
	"config": {
		"commitizen": {
			"path": "cz-conventional-changelog"
		}
	},
	"dependencies": {
		"@apollo/gateway": "^2.14.4",
		"@apollo/server": "^5.5.1",
		"@as-integrations/fastify": "^3.1.0",
		"@aws-sdk/client-cognito-identity-provider": "^3.1164.0",
		"@aws-sdk/client-s3": "^3.1164.0",
		"@aws-sdk/client-sns": "^3.1164.0",
		"@aws-sdk/client-sqs": "^3.1164.0",
		"@aws-sdk/s3-request-presigner": "^3.1164.0",
		"@fastify/formbody": "^9.0.1",
		"@fastify/multipart": "^10.1.8",
		"@fastify/static": "^10.1.10",
		"@nestjs/apollo": "^14.2.0",
		"@nestjs/common": "^12.4.0",
		"@nestjs/config": "^12.1.1",
		"@nestjs/core": "^12.4.0",
		"@nestjs/devtools-integration": "^12.0.0",
		"@nestjs/event-emitter": "^12.0.2",
		"@nestjs/graphql": "^14.2.0",
		"@nestjs/passport": "^12.0.1",
		"@nestjs/platform-fastify": "^12.4.0",
		"@nestjs/platform-socket.io": "^12.4.0",
		"@nestjs/platform-ws": "^12.4.0",
		"@nestjs/schedule": "^12.0.3",
		"@nestjs/swagger": "^12.1.1",
		"@nestjs/throttler": "^6.7.1",
		"@nestjs/websockets": "^12.4.0",
		"@sentry/nestjs": "^11.11.0",
		"@sentry/profiling-node": "^11.11.0",
		"@swc/cli": "^0.8.2",
		"@swc/core": "^1.16.22",
		"@swc/helpers": "^0.5.24",
		"@swc/jest": "^0.2.39",
		"axios": "^1.21.0",
		"axios-retry": "^4.5.0",
		"bcrypt": "^6.0.0",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.4",
		"compression": "^1.8.2",
		"cors": "^2.8.6",
		"cross-env": "^10.1.0",
		"dotenv": "^17.4.2",
		"ejs": "^3.1.10",
		"fastify": "5.12.8",
		"graphql": "^16.15.0",
		"ioredis": "^5.11.1",
		"joi": "^18.3.2",
		"jsonwebtoken": "^9.0.3",
		"luxon": "^3.7.2",
		"mongodb": "^6.22.0",
		"multer": "^2.5.0",
		"path": "^0.12.7",
		"pg": "^8.23.1",
		"pg-hstore": "^2.3.4",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"socket.io": "^4.8.4",
		"socket.io-client": "^4.8.4",
		"sqs-consumer": "^15.0.4",
		"ts-morph": "^25.0.1",
		"ts-node": "^10.9.2",
		"typeorm": "^0.3.31",
		"typescript": "^6.0.3",
		"uuid": "^11.1.1",
		"winston": "^3.19.0"
	},
	"devDependencies": {
		"@commitlint/cli": "^20.5.3",
		"@commitlint/config-conventional": "^20.5.3",
		"@nestjs/cli": "^12.0.12",
		"@nestjs/schematics": "^12.0.13",
		"@nestjs/testing": "^12.4.0",
		"@semantic-release/commit-analyzer": "^13.0.1",
		"@semantic-release/git": "^10.0.1",
		"@semantic-release/github": "^12.0.10",
		"@semantic-release/npm": "^13.2.0",
		"@semantic-release/release-notes-generator": "^14.1.1",
		"@sentry/cli": "^2.58.6",
		"@types/bcrypt": "^6.0.0",
		"@types/compression": "^1.8.1",
		"@types/ejs": "^3.1.5",
		"@types/jest": "^30.0.0",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/multer": "^2.3.0",
		"@types/node": "^24.19.2",
		"@types/supertest": "^6.0.3",
		"@types/uuid": "^10.0.0",
		"@types/webpack-node-externals": "^3.0.4",
		"@types/ws": "^8.18.2",
		"child_process": "^1.0.2",
		"commitizen": "^4.3.2",
		"cz-conventional-changelog": "^3.3.0",
		"jest": "^30.5.2",
		"jest-cli": "^30.3.0",
		"jest-sonar-reporter": "^2.0.0",
		"lefthook": "^1.13.6",
		"mongo-mock": "^4.2.0",
		"nodemon": "^3.1.14",
		"nyc": "^18.0.0",
		"oxfmt": "^0.77.0",
		"oxlint": "^1.92.0",
		"semantic-release": "^25.0.9",
		"sonarqube-scanner": "^5.0.2",
		"source-map-support": "^0.5.21",
		"supertest": "^7.3.2",
		"ts-jest": "^29.4.15",
		"ts-loader": "^9.6.2",
		"ts-node-dev": "^2.0.0",
		"tsconfig-paths": "^4.2.0",
		"typeorm-extension": "^3.9.0",
		"webpack": "^5.112.2",
		"webpack-cli": "^6.0.1",
		"webpack-node-externals": "^3.0.0"
	}
}
