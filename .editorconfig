root = true


[*]
charset = utf-8
indent_style = tab
indent_size = 2
tab_width = 2
quote_type = single
max_line_length = 160
trim_trailing_whitespace = true
end_of_line = lf
insert_final_newline = true

[*.{json,jsonc}]
max_line_length = 190

[*.md]
max_line_length = 120
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_style = space
indent_size = 2
max_line_length = 120

[*.{sh,bash,zsh}]
indent_style = tab
indent_size = 2
